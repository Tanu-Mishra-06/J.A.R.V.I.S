    {
      "source": "order-service",
      "target": "inventory-service",
      "latency_p95": 22.0
    },
    {
      "source": "order-service",
      "target": "database-primary",
      "latency_p95": 8.5
    },
    {
      "source": "auth-service",
      "target": "redis-cache",
      "latency_p95": 3.2
    },
    {
      "source": "auth-service",
      "target": "database-primary",
      "latency_p95": 9.1
    }
  ]
}