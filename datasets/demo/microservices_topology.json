{
  "services": [
    {
      "name": "api-gateway",
      "type": "gateway",
      "host": "gw-node-01",
      "description": "Cloud API Gateway"
    },
    {
      "name": "auth-service",
      "type": "web",
      "host": "auth-node-01",
      "description": "OAuth & JWT Token Authority"
    },
    {
      "name": "order-service",
      "type": "web",
      "host": "order-node-01",
      "description": "Core Business Order Service"
    },
    {
      "name": "inventory-service",
      "type": "web",
      "host": "inv-node-01",
      "description": "Warehouse & Stock Manager"
    },
    {
      "name": "database-primary",
      "type": "database",
      "host": "db-node-01",
      "description": "PostgreSQL Primary Cluster"
    },
    {
      "name": "redis-cache",
      "type": "cache",
      "host": "cache-node-01",
      "description": "In-memory Redis Cluster"
    }
