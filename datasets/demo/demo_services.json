{
  "services": [
    {
      "name": "api-gateway",
      "type": "gateway",
      "description": "API Gateway - routes incoming requests to backend services"
    },
    {
      "name": "auth-service",
      "type": "web",
      "description": "Authentication and authorization service"
    },
    {
      "name": "user-service",
      "type": "web",
      "description": "User profile and account management service"
    },
    {
      "name": "order-service",
      "type": "web",
      "description": "Business logic and order processing service"
    },
    {
      "name": "database-primary",
      "type": "database",
      "description": "Primary PostgreSQL database instance"
    },
    {
      "name": "cache-redis",
      "type": "cache",
      "description": "Redis caching layer for sessions and hot data"
    },
    {
      "name": "message-queue",
      "type": "queue",
      "description": "Message broker for async task processing"
    },
    {
      "name": "storage-service",
      "type": "web",
      "description": "File and object storage service"
    }
  ],
  "dependencies": [
    {
      "source": "api-gateway",
      "target": "auth-service",
      "type": "calls"
    },
    {
      "source": "api-gateway",
      "target": "user-service",
      "type": "calls"
    },
    {
      "source": "api-gateway",
      "target": "order-service",
      "type": "calls"
    },
    {
      "source": "auth-service",
      "target": "database-primary",
      "type": "calls"
    },
    {
      "source": "auth-service",
      "target": "cache-redis",
      "type": "calls"
    },
    {
      "source": "user-service",
      "target": "database-primary",
      "type": "calls"
    },
    {
      "source": "user-service",
      "target": "cache-redis",
      "type": "calls"
    },
    {
      "source": "order-service",
      "target": "database-primary",
      "type": "calls"
    },
    {
      "source": "order-service",
      "target": "message-queue",
      "type": "calls"
    },
    {
      "source": "order-service",
      "target": "storage-service",
      "type": "calls"
    },
    {
      "source": "storage-service",
      "target": "database-primary",
      "type": "calls"
    }
  ]
}